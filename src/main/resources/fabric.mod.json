{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "TikTok-style synced lyrics for your music, huge in the sky, floating in front of you, pinned in the world or on the HUD.",
  "authors": ["Vibe Craft Studios"],
  "contact": {
    "homepage": "https://vibec-studios.github.io/mods/vibey-lyrics/",
    "sources": "https://github.com/vibec-studios/vibey-lyrics",
    "issues": "https://github.com/vibec-studios/vibey-lyrics/issues"
  },
  "license": "MIT",
  "icon": "assets/vibeylyrics/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.henny.lyrics.fabric.VibeyLyricsClient"]
  },
  ${mixins}
  "depends": {
    "fabricloader": ">=0.16.5",
    "fabric-api": "*",
    "minecraft": "${minecraft_range}",
    "java": ">=${java}"
  }
}
